<%- include('partials/head') %>
<div class="admin-head"><h1>Wachtwoord wijzigen</h1></div>
<% if (saved) { %><div class="alert alert-ok">Wachtwoord gewijzigd ✓</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="panel" style="max-width:480px">
  <form method="post" action="/admin/password">
    <label class="field"><span>Huidig wachtwoord</span><input class="input" type="password" name="current" required autocomplete="current-password"></label>
    <label class="field"><span>Nieuw wachtwoord (min. 8 tekens)</span><input class="input" type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <label class="field"><span>Herhaal nieuw wachtwoord</span><input class="input" type="password" name="confirm" required autocomplete="new-password"></label>
    <button type="submit" class="btn btn-red">Wijzig wachtwoord</button>
  </form>
</div>
<%- include('partials/foot') %>
