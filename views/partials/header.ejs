<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-msg">Nederlandse studiegroep uro-oncologie · 27 aangesloten ziekenhuizen</span>
      <nav class="topbar-links">
        <a href="<%= settings.forum_url %>" target="_blank" rel="noopener">Forums</a>
        <a href="<%= settings.youtube_url %>" target="_blank" rel="noopener">YouTube</a>
        <a href="/foundation-dutch-uro-oncology-studygroup-duos/">English</a>
      </nav>
    </div>
  </div>
  <div class="header-main">
    <div class="container header-inner">
      <a href="/" class="site-logo">
        <img src="<%= settings.logo %>" alt="<%= settings.site_title %>">
        <span class="logo-text">
          <strong><%= settings.site_title %></strong>
          <small><%= settings.site_tagline %></small>
        </span>
      </a>
      <nav class="main-nav" id="main-nav" aria-label="Hoofdmenu">
        <ul>
          <% for (const item of menu) { %>
            <li class="<%= item.children && item.children.length ? 'has-sub' : '' %>">
              <a href="<%= item.url %>" <%= /^https?:/.test(item.url) ? 'target=_blank rel=noopener' : '' %>><%= item.label %><% if (item.children && item.children.length) { %><span class="caret">▾</span><% } %></a>
              <% if (item.children && item.children.length) { %>
                <% const hasGroups = item.children.some(c => c.children && c.children.length); %>
                <div class="sub <%= hasGroups ? 'mega' : '' %>">
                  <% if (hasGroups) { %>
                    <div class="mega-cols">
                      <% for (const c of item.children) { %>
                        <div class="mega-col">
                          <a class="mega-head" href="<%= c.url %>"><%= c.label %></a>
                          <% if (c.children && c.children.length) { %>
                            <ul>
                              <% for (const g of c.children) { %><li><a href="<%= g.url %>"><%= g.label %></a></li><% } %>
                            </ul>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                  <% } else { %>
                    <ul>
                      <% for (const c of item.children) { %><li><a href="<%= c.url %>"><%= c.label %></a></li><% } %>
                    </ul>
                  <% } %>
                </div>
              <% } %>
            </li>
          <% } %>
        </ul>
      </nav>
      <div class="header-actions">
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Zoeken">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
        </button>
        <a href="<%= settings.donate_url %>" class="btn btn-red donate-btn">♥ Doneer nu</a>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
      </div>
    </div>
  </div>
  <div class="search-panel" id="search-panel" hidden>
    <div class="container">
      <form action="/zoeken" method="get" class="search-form">
        <input type="search" name="q" placeholder="Zoek in nieuws, studies en pagina's…" value="<%= searchQuery %>" autocomplete="off">
        <button type="submit" class="btn btn-red">Zoeken</button>
      </form>
    </div>
  </div>
</header>
<main id="main">
