<article class="post-card">
  <a href="/<%= p.slug %>/" class="pc-img">
    <% if (p.featured_image) { %>
      <img src="<%= p.featured_image %>" alt="" loading="lazy">
    <% } else { %>
      <span class="pc-placeholder">DUOS</span>
    <% } %>
    <time class="pc-date" datetime="<%= p.date %>"><%= formatDate(p.date) %></time>
  </a>
  <div class="pc-body">
    <% if (p.cats && p.cats.length) { %>
      <div class="pc-cats">
        <% for (const c of p.cats.slice(0, 2)) { %><a class="chip" href="/category/<%= c.slug %>/"><%= c.name %></a><% } %>
      </div>
    <% } %>
    <h3><a href="/<%= p.slug %>/"><%- p.title %></a></h3>
    <% if (p.excerpt) { %><p><%= p.excerpt.length > 160 ? p.excerpt.slice(0, 160) + '…' : p.excerpt %></p><% } %>
    <a class="pc-more" href="/<%= p.slug %>/">Lees meer →</a>
  </div>
</article>
