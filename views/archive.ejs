<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="page-hero">
  <div class="container">
    <nav class="breadcrumbs"><a href="/">Home</a> <span>›</span> <span class="bc-current"><%= title %></span></nav>
    <h1><%= title %></h1>
    <p class="archive-count"><%= total %> artikelen</p>
  </div>
</div>

<div class="container">
  <div class="card-grid archive-grid">
    <% for (const p of posts) { %><%- include('partials/postcard', { p }) %><% } %>
  </div>
  <% if (totalPages > 1) { %>
    <nav class="pagination">
      <% if (page > 1) { %><a class="pg" href="<%= baseUrl %><%= page - 1 > 1 ? '/page/' + (page - 1) : '' %>/">← Vorige</a><% } %>
      <%
        const win = [];
        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || Math.abs(i - page) <= 2) win.push(i);
          else if (win[win.length - 1] !== '…') win.push('…');
        }
      %>
      <% for (const i of win) { %>
        <% if (i === '…') { %><span class="pg dots">…</span><% } else if (i === page) { %><span class="pg current"><%= i %></span><% } else { %><a class="pg" href="<%= baseUrl %><%= i > 1 ? '/page/' + i : '' %>/"><%= i %></a><% } %>
      <% } %>
      <% if (page < totalPages) { %><a class="pg" href="<%= baseUrl %>/page/<%= page + 1 %>/">Volgende →</a><% } %>
    </nav>
  <% } %>
</div>

<%- include('partials/footer') %>
